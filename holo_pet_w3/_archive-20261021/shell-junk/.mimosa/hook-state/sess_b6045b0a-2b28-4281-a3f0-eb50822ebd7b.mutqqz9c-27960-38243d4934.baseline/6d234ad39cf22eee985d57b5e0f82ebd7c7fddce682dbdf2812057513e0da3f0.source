ontrol","bundle":"device","safe":true,"impl":true,"desc":"AI 智能蓝牙操控：自然语言意图→扫描识别设备→协议匹配→组装指令→写入执行→验证（协议库只收公开文档协议，未知如实报告）","files":["gbt_allinone/__init__.py"],"file":"gbt_allinone/__init__.py"},{"id":"absorb_loop","bundle":"brain","safe":true,"impl":true,"desc":"吞天闭环（只读骨架）：蒸馏 DISTILL → 提炼 REFINE → 吸收 ABSORB + 回灌 FED_BACK；四条机械闸（stag","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"dream_replay","bundle":"brain","safe":true,"impl":true,"desc":"做梦技能只读重演：五原语闭环，不写盘、不执行（巩固默认不开）","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"coze_mail","bundle":"comms","safe":true,"impl":true,"desc":"通信域：对主人自有的单一地址（@coze.email）收发与整理；白名单默认空（全拒）、confirm_token 绑定内容、正文不入档、独","files":["gbt_allinone/__init__.py"],"file":"gbt_allinone/__init__.py"},{"id":"vision","bundle":"vision","safe":true,"impl":true,"desc":"视觉/图像识别入口（良性子集，需外部依赖时留待接入）","files":["gbt_allinone/__init__.py"],"file":"gbt_allinone/__init__.py"},{"id":"browser","bundle":"automation","safe":true,"impl":true,"desc":"浏览器自动化入口（良性子集）。op=open/search/fetch/automate 走 browser_cap 三级后端；op=nat","files":["gbt_allinone/__init__.py","gbt_allinone/api.py"],"file":"gbt_allinone/__init__.py"},{"id":"life","bundle":"life","safe":true,"impl":true,"desc":"生命档案：事件记录、时光轴、每日回顾、章节、承诺、习惯、反思与 Vault 导出（写框架 store，不出网）","files":[],"file":null},{"id":"a1art_skill","bundle":"image_video","safe":true,"impl":true,"desc":"a1.art API 技能（只读骨架·门）：五原语 LOOKUP→UPLOAD→GENERATE→OPTIMIZE→POLL；密钥只走 DP","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"feishu_embed","bundle":"integration","safe":true,"impl":true,"desc":"飞书镶嵌窗口（只读骨架·门）：面板卡⑥，**走浏览器触手不用 API**；四条红线（飞书是副本本地是源/凭据不许明文/不绕验证/每次操作留痕","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"gate_visibility","bundle":"framework","safe":true,"impl":true,"desc":"门可见性审计（只读骨架·门）：三态=已纳入/显式不纳入/未决定 —— 回答『门看得见什么、看不见什么』（坑册 §60）；可见范围只从 fra","files":["gbt_allinone/tools/_