ile":"gbt_allinone/tentacle/__init__.py"},{"id":"tentacle","bundle":"tentacle","safe":true,"impl":true,"desc":"触手/眼睛/双手/手：默认调本体原生能力，给意图自动命中，不给方法名也行；桌面动作见 see/read_text/click/type/li","files":["gbt_allinone/tentacle/__init__.py"],"file":"gbt_allinone/tentacle/__init__.py"},{"id":"tentacle_manifest","bundle":"tentacle","safe":true,"impl":true,"desc":"触手能力总纲：66 项能力 + 三通道感官 + 六铁律（注入大脑上下文）","files":["gbt_allinone/tentacle/__init__.py"],"file":"gbt_allinone/tentacle/__init__.py"},{"id":"tentacle_pipeline","bundle":"tentacle","safe":true,"impl":true,"desc":"触手自动化流水线：四层七步、三公理、五红线；隔离执行、逐层汇报、dry-run 读数、终审只判不改、发布带回滚","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"tentacle_status","bundle":"tentacle","safe":true,"impl":true,"desc":"触手自诊断：硬件层就绪度 + 依赖分层 + 邻域覆盖","files":["gbt_allinone/tentacle/__init__.py"],"file":"gbt_allinone/tentacle/__init__.py"},{"id":"audio_extract","bundle":"video","safe":false,"impl":true,"desc":"从视频里取出声音（本机 ffmpeg，**零出网**）：probe/tracks 读流与音轨（只读）；extract 真出音频件（mp3/a","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"audio_mix","bundle":"video","safe":false,"impl":true,"desc":"混音与母带（本机 ffmpeg，**零出网**）：`mix` 多轨合成（amix，逐路音量，显式 normalize=0）；`master`","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"edit_pipeline","bundle":"video","safe":false,"impl":true,"desc":"剪辑引擎（蒸馏剪映时间线语义）：轨道→片段→目标/源时间区间→变速/音量/转场/文本，真渲染 1080x1920 成片（ffmpeg + l","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"h3_video_gen","bundle":"video","safe":true,"impl":true,"desc":"H3mini 视频生成（只读骨架·门）：四原语 T2VA/I2VA/FL2VA/Ref2VA + 三条带牙用例（密钥不走明文 / 结果必须落","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"libtv_skill","bundle":"video","safe":true,"impl":true,"desc":"LibTV 技能（只读骨架·门）：Agent 创作平台入口（会话进展/增量轮询 + 切项目 + 批量下载）；密钥走 model_key_po","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"libtv_workflow","bundle":"video","safe":true,"impl":true,"desc":"LibTV 节点式工作流（只读骨架·门）：五动作 create_node/connect/set_params/run/batch_run ","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"media_license","bundle":"video","safe":false,"impl":true,"desc":"素材许可账（三方向流程台「家规第 2 条：没有许可的素材不许进成品格」的数据源）：`register` 逐件登记（**现算 sha256**","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"media_pipeline","bundle":"video","safe":true,"impl":true,"desc":"AI短视频/电影/音乐流水线：镜像房间编排、产物自审、版权/安全/品牌/质量检查、主人授权后发布","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"media_publish","bundle":"video","safe":false,"impl":true,"desc":"三方向**发布到赚钱平台**的准备与授权门：`platforms <方向>` 读平台口径（**音乐复用能力位 `music_publishi","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"media_run","bundle":"video","safe":false,"impl":true,"desc":"三方向自动化工作流**执行器**：一次调用把一条链从头走到尾，每步落真件 + 同批登记许可。链取自 `media_pipeline.KIND","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"sched_define","bundle":"engine","safe":true,"impl":true,"desc":"定时触发器：定义调度（工作流 + 间隔），无人值守自动执行","files":["gbt_allinone/__init__.py"],"file":"gbt_allinone/__init__.py"},{"id":"sched_status","bundle":"engine","safe":true,"impl":true,"desc":"定时触发器：查调度状态（上次执行/结果）","files":["gbt_allinone/__init__.py"],"file":"gbt_allinone/__init__.py"},{"id":"sched_tick","bundle":"engine","safe":true,"impl":true,"desc":"定时触发器：扫描到期调度并执行（可由循环/计划任务驱动）","files":["gbt_allinone/__init__.py"],"file":"gbt_allinone/__init__.py"},{"id":"transfer","bundle":"engine","safe":true,"impl":true,"desc":"数据传输算子（核心传输工具）：map/filter/merge/unique/sort/pluck/collect 等 14 个纯变换算子","files":["gbt_allinone/__init__.py"],"file":"gbt_allinone/__init__.py"},{"id":"wf_cache_clear","bundle":"engine","safe":true,"impl":true,"desc":"万能插：清空传输缓存（同输入复用的节点结果缓存）","files":["gbt_allinone/__init__.py"],"file":"gbt_allinone/__init__.py"},{"id":"wf_define","bundle":"engine","safe":true,"impl":true,"desc":"万能插执行引擎：定义工作流（DAG，校验环/依赖/能力合法性）","files":["gbt_allinone/__init__.py"],"file":"gbt_allinone/__init__.py"},{"id":"wf_resume","bundle":"engine","safe":true,"impl":true,"desc":"万能插执行引擎：从运行记录断点续跑（复用已完成节点，只重跑未完成的）","files":["gbt_allinone/__init__.py"],"file":"gbt_allinone/__init__.py"},{"id":"wf_run","bundle":"engine","safe":true,"impl":true,"desc":"万能插执行引擎：分层并行执行工作流，节点结果如实落盘","files":["gbt_allinone/__init__.py"],"file":"gbt_allinone/__init__.py"},{"id":"wf_status","bundle":"engine","safe":true,"impl":true,"desc":"万能插执行引擎：查运行记录（可按工作流名过滤）","files":["gbt_allinone/__init__.py"],"file":"gbt_allinone/__init__.py"},{"id":"auto_switch","bundle":"mind","safe":true,"impl":true,"desc":"自动化切换引擎（只读骨架·内调）：意图分析(L1解析+L2交叉验证+L3置信度)→任务分级→模型切换→原生执行→验证审计；接线点只有 Int","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"brain_vault","bundle":"mind","safe":true,"impl":true,"desc":"脑库接入：Obsidian 记忆库的读（recall=记忆总纲+收集箱）/ 写（remember=追加一条）/ 体检（status）—— 追","files":["gbt_allinone/__init__.py"],"file":"gbt_allinone/__init__.py"},{"id":"director_mood","bundle":"mind","safe":true,"impl":true,"desc":"导演 AI 情绪内核（只读）：七情六欲 + 半衰期；情绪只改『怎么看』，不改『看到什么』","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"local_brain","bundle":"mind","safe":true,"impl":true,"desc":"本地原生脑（只读骨架·内调）：本地模型=脑皮层（可换）·主机=纪律层（不可换）；五层链路（模型只做意图解析与结果解释）；五条红线（不许直接执","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"meta_cognition","bundle":"mind","safe":true,"impl":true,"desc":"元认知循环（只读骨架）：自省→查内部→查外部→问主人→沉淀 + 五条红线（自省不是自责/不许硬猜/先查后问/问完沉淀/大脑也自省）","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"mind","bundle":"mind","safe":true,"impl":true,"desc":"心智引擎：开工前预演 pre_work、评估、内部状态、经验召回与反思（写框架 store，不出网）","files":[],"file":null},{"id":"observer_anchor","bundle":"mind","safe":true,"impl":true,"desc":"观察者锚点律只读骨架：三公理 + 六短板补齐 + 五条红线（同一方不许既扫又报/审计器必须被审/递归封顶/终止点只能由人设/关键节点人在场）","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"persona_kernel","bundle":"mind","safe":true,"impl":true,"desc":"性格内核 v4.0：外温表达十律 + 内刚四基石（止损/主动/洞察/静待）+ 十条机械红线；四大基石原文一字不差；evolve 是唯一写口（","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"proactive_report","bundle":"mind","safe":true,"impl":true,"desc":"主动汇报引擎只读判据层：四类汇报（新奇发现/主人需要/记忆命中/赚钱机会）+ 四维打分 + 不打扰门（静默时段/预算/去重/及格线）+ 短律","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"brand_outro","bundle":"creation","safe":true,"impl":true,"desc":"品牌片尾只读渲染：署名/自述/致谢三层 + 四条红线（署名不造假·致谢不套话·承诺可追溯·观众不当流量）","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"code_art","bundle":"creation","safe":true,"impl":true,"desc":"代码艺术内核（只读骨架）：INDEX/SEED/CANVAS/LAYER/EXPORT 五原语；无种子不许导出","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"create","bundle":"creation","safe":true,"impl":true,"desc":"创作出口：创作意图/产物登记 ＋ 仅限 outputs/ 的文本写入；文本出口待接线（如实报 pending、不发网络请求）、覆盖必带 co","files":["gbt_allinone/__init__.py"],"file":"gbt_allinone/__init__.py"},{"id":"drama","bundle":"creation","safe":true,"impl":true,"desc":"剧本转分镜/拆分镜/分镜/短剧/故事板/剧本理解：剧本 → 结构化镜头表（景别·运镜·时长·情绪·角色位置·描述），字段齐全度与时长和逐条如","files":["gbt_allinone/__init__.py"],"file":"gbt_allinone/__init__.py"},{"id":"emotion_projection","bundle":"creation","safe":true,"impl":true,"desc":"情感投射只读骨架：叙事四问 → 投射细节 → 四项校验；『身临其境』只有人能判","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"music_publishing","bundle":"creation","safe":true,"impl":true,"desc":"AI 音乐发布平台三层只读归位（生成端/Agent 原生端/分发端）；全部标『未核实』","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"render_evolution","bundle":"creation","safe":true,"impl":true,"desc":"渲染进化内核（只读骨架）：五原语 + 三闭环 + 六红线；帕累托前沿机器画、人点","files":["gbt_allino