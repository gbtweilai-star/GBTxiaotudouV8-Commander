/tools/__init__.py"},{"id":"media_run","bundle":"video","safe":false,"impl":true,"desc":"三方向自动化工作流**执行器**：一次调用把一条链从头走到尾，每步落真件 + 同批登记许可。链取自 `media_pipeline.KIND","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"agency_tentacles","bundle":"tentacle","safe":true,"impl":true,"desc":"职业触手中枢：吸收 Agency Agents 职业资料；每根触手独立统一大模型会话与隔离镜像房间；支持并发汇总","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"desktop_commander","bundle":"tentacle","safe":true,"impl":true,"desc":"桌面指挥官（Desktop Commander MCP）：终端+文件系统全能力触手；支持本地 stdio 与 remote 设备模式","files":["gbt_allinone/tentacle/__init__.py"],"file":"gbt_allinone/tentacle/__init__.py"},{"id":"long_run_supervisor","bundle":"tentacle","safe":true,"impl":true,"desc":"长程无人值守任务监督：租约、心跳、检查点、有界重试、断点续作和主人升级","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"mcp_call","bundle":"tentacle","safe":true,"impl":true,"desc":"触手契约层：按契约调用已连接服务器的任意工具","files":["gbt_allinone/tentacle/__init__.py"],"file":"gbt_allinone/tentacle/__init__.py"},{"id":"mcp_connect","bundle":"tentacle","safe":true,"impl":true,"desc":"触手契约层：连接任意 MCP 工具服务器（学会契约协议=接入整个 MCP 生态）","files":["gbt_allinone/tentacle/__init__.py"],"file":"gbt_allinone/tentacle/__init__.py"},{"id":"mcp_tools","bundle":"tentacle","safe":true,"impl":true,"desc":"触手契约层：列出已连接服务器的工具契约清单（名称+参数 schema）","files":["gbt_allinone/tentacle/__init__.py"],"file":"gbt_allinone/tentacle/__init__.py"},{"id":"tentacle","bundle":"tentacle","safe":true,"impl":true,"desc":"触手/眼睛/双手/手：默认调本体原生能力，给意图自动命中，不给方法名也行；桌面动作见 see/read_text/click/type/li","files":["gbt_allinone/tentacle/__init__.py"],"file":"gbt_allinone/tentacle/__init__.py"},{"id":"tentacle_manifest","bundle":"tentacle","safe":true,"impl":true,"desc":"触手能力总纲：66 项能力 + 三通道感官 + 六铁律（注入大脑上下文）","files":["gbt_allinone/tentacle/__init__.py"],"file":"gbt_allinone/tentacle/__init__.py"},{"id":"tentacle_pipeline","bundle":"tentacle","safe":true,"impl":true,"desc":"