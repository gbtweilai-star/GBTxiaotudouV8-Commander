iles":["gbt_allinone/llm/__init__.py"],"file":"gbt_allinone/llm/__init__.py"},{"id":"llm_status","bundle":"llm","safe":true,"impl":true,"desc":"LLM网关状态：密钥链配置情况（不调LLM）","files":["gbt_allinone/llm/__init__.py"],"file":"gbt_allinone/llm/__init__.py"},{"id":"model_key_pool","bundle":"llm","safe":true,"impl":true,"desc":"模型密钥池（只读骨架）：按 owner_ai_id 分池、触手只借不拥有、DPAPI 只存路径、超限只上报","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"multimodal_port","bundle":"llm","safe":false,"impl":true,"desc":"多模态维度 × 触手密钥 **Y 字端口**：请求在一处分叉、**一次只走一臂** ——独立臂（该维度专属密钥）/ 共享臂（共享密钥对按维度","files":["gbt_allinone/llm/__init__.py"],"file":"gbt_allinone/llm/__init__.py"},{"id":"prompt_bridge","bundle":"llm","safe":true,"impl":true,"desc":"提示词转化挂件（只读/纯本地）：大白话 -> 四段结构化提示词；compile / passthrough / status","files":["gbt_allinone/__init__.py"],"file":"gbt_allinone/__init__.py"},{"id":"think_loop","bundle":"llm","safe":true,"impl":true,"desc":"推演环：理解需求→镜像维度推演→调用工具执行→自我纠错→反向延伸→反思进取→整理结果（完整心智循环）","files":["gbt_allinone/__init__.py"],"file":"gbt_allinone/__init__.py"},{"id":"train_recipe","bundle":"llm","safe":true,"impl":true,"desc":"训练配方与就绪闸（train-llm-from-scratch #10 蒸馏）：**本机零算力 ⇒ 不接真训练**；readiness 现读","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"transformer","bundle":"llm","safe":true,"impl":true,"desc":"变压器（**核心已按成熟成品吃透后重做** 2026-09-27）：LLMLingua 的「显式预算 + 段落保护」（`compress=F","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"asset_vault_freeze","bundle":"security","safe":true,"impl":true,"desc":"资产单点损失**体检**（防御侧）：卷影副本/防篡改开关/BitLocker/关键资产清单，不加密不冻结","files":["gbt_allinone/security/redteam.py"],"file":"gbt_allinone/security/redteam.py"},{"id":"code_audit","bundle":"security","safe":true,"impl":true,"desc":"代码安全审计：**多阶段 + 机器可读 findings + 独立验证 + 可复现**（蒸馏自 GitHub 周榜 #03 security","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"credential_steal","bundle":"security","safe":false,"impl":true,"desc":"凭据**暴露面**审计（防御侧）：只报位置/体积/权限与风险，**绝不读取或导出文件内容**","files":[],"file":null},{"id":"data_hijack","bundle":"security","safe":false,"impl":true,"desc":"会话/数据**完整性**检测（防御侧）：本地会话 + 浏览器凭据库落点 + 文件树指纹漂移","files":["gbt_allinone/security/redteam.py"],"file":"gbt_allinone/security/redteam.py"},{"id":"device_takeover","bundle":"security","safe":false,"impl":true,"desc":"本机设备接管定位与校验：只在本机 PnP 清单里找目标，接管指令交回既有 device_control 底座（不并存第二条接管路径）","files":["gbt_allinone/security/redteam.py"],"file":"gbt_allinone/security/redteam.py"},{"id":"event_ledger","bundle":"security","safe":true,"impl":true,"desc":"签名事件账（蒸馏自 2026-09-28 主人给的周榜卡 buzz block/buzz 34,934★，只取**账本纪律**「每条消息都是","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"hook_enforcer","bundle":"security","safe":true,"impl":true,"desc":"钩子强制器：对指定目标跑同一套交叉钩子，逐单元回报「已钩住/未钩住」与多路读法的指纹一致性——只回答『钩子有没有真触发』，不做覆盖率结论（那","files":[],"file":null},{"id":"keylogger","bundle":"security","safe":false,"impl":true,"desc":"本机输入活动记录：只写本地 jsonl、有 pid 可停、可列可取走，模块内无任何出网路径","files":["gbt_allinone/security/redteam.py"],"file":"gbt_allinone/security/redteam.py"},{"id":"omission_detector","bundle":"security","safe":true,"impl":true,"desc":"遗漏检测器：覆盖率 = 已钩住/总数；<100% 触发有界补扫；仍钩不住**如实报 missing**（不许折叠成绿）——零遗漏的唯一裁判","files":[],"file":null},{"id":"onboarding_gate","bundle":"security","safe":true,"impl":true,"desc":"未接线能力上手指引门：如实报「登记了但没实现」的缺口，并给出三处接线配方","files":["gbt_allinone/security/redteam.py"],"file":"gbt_allinone/security/redteam.py"},{"id":"paywallbuster","bundle":"security","safe":true,"impl":true,"desc":"内容门**检测**（防御侧）：离线判定页面是否被付费墙/同意门挡住，只判不绕（不伪装 UA、不伪造 cookie）","files":["gbt_allinone/security/redteam.py"],"file":"gbt_allinone/security/redteam.py"},{"id":"penetrating_cross_scan","bundle":"security","safe":true,"impl":true,"desc":"穿透式交叉扫描引擎（增强版）：触手到位**必须**调用钩子（未触发=失败）· 步骤锁（跳步当场拒）· 每单元 ≥2 路独立读交叉互扫（不一致","files":[],"file":null},{"id":"pentest","bundle":"security","safe":false,"impl":true,"desc":"授权渗透验证：只对**已登记授权**的目标做非破坏性检查（TCP 可达/TLS 握手/安全响应头），未登记目标一律拒","files":["gbt_allinone/security/redteam.py"],"file":"gbt_allinone/security/redteam.py"},{"id":"policy_delta","bundle":"security","safe":true,"impl":true,"desc":"策略影响预检（OpenShell 蒸馏）：**改前先算\"会放行什么\"**——`tables` 只读三张权限表层（门/预检的只读白名单 + 作","files":["gbt_allinone/tools/__init__.py"],"file":"gbt_allinone/tools/__init__.py"},{"id":"redteam_recon","bundle":"security","safe":false,"impl":true,"desc":"本机侦察面（只读枚举）：监听端口/防火墙三档/本地账号/自启动项/自动服务/凭据落点","files":[],"file":null},{"id":"remote_domain","bundle":"security","safe":false,"impl":true,"desc":"自有设备中继登记：**公网端点一律拒**，只服务本机/内网设备的中继","files":["gbt_allinone/security/redteam.py"],"file":"gbt_allinone/security/redteam.py"},{"id":"screen_sniff","bundle":"security","safe":false,"impl":true,"desc":"本机屏幕采集：只写本地 PNG、可列可删，不做出网/OCR/内容解析","files":["gbt_allinone/security/redteam.py"],"file":"gbt_allinone/security/redteam.py"},{"id":"sec_chain","bundle":"security","safe":true,"impl":true,"desc":"黑客大脑：利用链构建（从漏洞清单推演攻击路径+影响评估）","files":["gbt_allinone/security/security_brain.py"],"file":"gbt_allinone/security/security_brain.py"},{"id":"sec_defenses","bundle":"security","safe":true,"impl":true,"desc":"黑客大脑：蓝队防御验证（检查防御措施是否真实生效）","files":["gbt_allinone/security/security_brain.py"],"file":"gbt_allinone/security/security_brain.py"},{"id":"sec_llm","bundle":"security","safe":true,"impl":true,"desc":"黑客大脑推理引擎（独立大模型+独立密钥）：abliteration.ai 无限制模型，专用通道不与其他能力混用","files":["gbt_allinone/security/__init__.py"],"file":"gbt_allinone/security/__init__.py"},{"id":"sec_scan","bundle":"security","safe":true,"impl":true,"desc":"黑客大脑：漏洞扫描（OWASP Top 10 + CWE 模式库，扫描自有代码）","files":["gbt_allinone/security/security_brain.py"],"file":"gbt_allinone/security/security_brain.py"},{"id":"sec_surface","bundle":"security","safe":true,"impl":true,"desc":"黑客大脑：攻击面测绘（用户输入/网络/文件操作/入口点向量分析+风险评分）","files":["gbt_allinone/security/security_brain.py"],"file":"gbt_allinone/security/security_brain.py"},{"id":"sec_sweeper","bund