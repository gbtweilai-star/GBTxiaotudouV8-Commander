\ \\Ul-TARS Desktop 能力位处理器\\\\nfrom gbt_allinone import run_task\n\ndef handle(op, params):\n    if op == \status\:\n        return {\ok\: True, \name\: \ul_tars_desktop\, \version\: \0.1\}\n    if op == \launch\:\n        return run_task(\desktop_commander\, {\op\: \launch\, \app\: params.get(\app\)})\n    if op == \window_list\:\n        return run_task(\desktop_commander\, {\op\: \list_windows\})\n    if op == \click\:\n        return run_task(\domain_cyborg\, {\op\: \click\, \x\: params.get(\x\), \y\: params.get(\y\)})\n    return {\ok\: False, \error\: \unknown op\}\n