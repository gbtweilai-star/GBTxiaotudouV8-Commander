    },
    {
      "what": "浏览器打开 / 抓网页",
      "say": ["打开网页", "抓网页", "浏览器", "截图网页", "搜索一下"],
      "caps": {"browser": 10}
    },
    {
      "what": "出声 / 念一段 / 听写",
      "say": ["念一段", "朗读", "出声", "配音", "语音合成", "听写", "转写"],
      "caps": {"voice": 10, "voice_orchestra": 5}
