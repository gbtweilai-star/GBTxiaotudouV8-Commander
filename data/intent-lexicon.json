      "caps": {"project_context": 10, "platform_profile": 5}
    },
    {
      "what": "改代码 / 打补丁",
      "say": ["改代码", "打补丁", "patch", "提交改动", "git"],
      "caps": {"code_patch": 10, "git_write": 6, "git_read": 4}
    },
    {
      "what": "吞一个仓库 / 自我进化",
      "say": ["吞一个", "吞天", "进化", "吸收这个仓库"],
      "caps": {"devour_scan": 10, "absorb_loop": 5}
    },
    {
      "what": "多条触手一起干 / 协作场",
      "say": ["协作", "一起干", "信息素", "留个痕迹"],
      "caps": {"stigmergy": 10, "collab_gateway": 6}
    },
    {
      "what": "对外发布作品 / 结算收益",
      "say": ["发布作品", "推广", "收益", "结算"],
      "caps": {"auto_publish": 10}
    },
    {
      "what": "登记 / 校验账号表",
      "say": ["账号表", "登记账号", "校验账号"],
      "caps": {"account_registry": 10}
    }
