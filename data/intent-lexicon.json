      "caps": {"genoffice": 10, "genoffice_bridge": 4}
    },
    {
      "what": "数一数有多少字",
      "say": ["字数", "多少字", "词数", "统计词"],
      "caps": {"count_words": 10}
    },
    {
      "what": "查审计账 / 谁调了什么",
      "say": ["审计", "查账", "谁调了", "调用记录", "留痕"],
      "caps": {"audit_query": 10, "caps_called_audit": 4}
    },
    {
      "what": "发布到生产 / 上线",
      "say": ["发布", "上线", "推到生产", "晋升", "部署到生产", "放上线"],
      "caps": {"one_key_deploy": 10}
    },
    {
      "what": "回滚 / 退版本",
      "say": ["回滚", "退版本", "上一个版本", "撤回去"],
      "caps": {"pipeline_rollback": 10, "mirror_rewind": 6}
    },
    {
      "what": "扫描镜像 / 看看有没有脏东西",
      "say": ["镜像", "脏东西", "残留", "体检", "扫描一下", "清理旧"],
      "caps": {"mirror_scan": 10, "cross_scan": 5, "file_hygiene": 5}
    },
    {
      "what": "自检 / 现在健康吗",
      "say": ["自检", "健康", "体检一下", "框架状态", "有没有坏"],
      "caps": {"selfscan": 10, "health": 8}
    },
    {
