# =============================================================================
#  gbt_wallet 收款钱包 · 环境变量模板 (占位符, 严禁填写真实值后提交)
# -----------------------------------------------------------------------------
#  用法:
#    Windows(当前会话)   : 复制本文件到工作区外(如 %USERPROFILE%\.gbt\wallet.env)并逐行改值, 再执行
#                          gbt_allinone\deploy\run_wallet.ps1 前用 -EnvFile 指向它
#    Windows(计划任务)   : 口令/令牌写进任务的动作命令行或机器级环境变量, 不要写进脚本文件
#    Linux(systemd)      : 复制到 /etc/gbt-wallet/wallet.env, chmod 600 且 chown root:root
#    Docker Compose      : 复制到 gbt_allinone/deploy/.env (该文件名已被 .gitignore 覆盖)
#
#  禁令: 不要把真实 GBT_WALLET_PASS / GBT_WALLET_API_TOKEN / RPC Key 提交进仓库。
#        钱包口令只存在内存/密钥管理系统; master.enc 已用口令派生密钥加密(AES-256-GCM, PBKDF2-SHA256)。
# =============================================================================

# ---------- 1. 钱包核心(必需) ----------

# 钱包口令。>=16 位高熵; 缺失则服务无法派生地址/开票(只读接口仍可用)。
# 安全提示: 口令 + master.enc 同时泄露 = 助记词泄露 = 资金丢失, 二者必须分开保管。
GBT_WALLET_PASS=<CHANGE_ME_strong_passphrase_min_16_chars>

# 数据根(含 master.enc / invoices.json / cursor.json / ledger.jsonl / users.json / sessions.json 等)
# Windows 默认: %USERPROFILE%\.gbt\gbt_wallet
# Linux   默认: /var/lib/gbt-wallet
GBT_WALLET_DIR=<CHANGE_ME_absolute_data_dir>

# 服务端口(默认 8097); 生产由反向代理转发, 端口不直接对公网开放。
GBT_WALLET_PORT=8097

# 绑定地址。保持 127.0.0.1; 仅容器内需要监听 0.0.0.0(由 compose 的 command 覆盖),
# 且容器端口只发布到宿主回环(见 docker-compose.yml 的 "127.0.0.1:8097:8097")。
GBT_WALLET_BIND_HOST=127.0.0.1

# ---------- 2. 接轨层(可选, 建议生产开启) ----------

# 服务令牌。留空 = 不鉴权(仅依赖 127.0.0.1 边界, 与接入前行为一致);
# 非空 = 所有接口要求 Authorization: Bearer <token>(常数时间比较)。
# 生成建议: python -c "import secrets;print(secrets.token_urlsafe(32))"
GBT_WALLET_API_TOKEN=<CHANGE_ME_leave_empty_to_disable_auth>

# CORS 允许来源, 逗号分隔。留空 = "*"(保持现状, 仅适合本机开发)。
# 生产务必显式白名单, 例如: https://app.example.com,https://ops.example.com
GBT_CORS_ORIGINS=<CHANGE_ME_or_leave_empty_for_star>

# 平台侧客户端(调用钱包 API 的一侧)使用的基址与幂等表位置。
GBT_WALLET_API_BASE=http://127.0.0.1:8097
GBT_PLATFORM_IDEM_FILE=<CHANGE_ME_platform_side_state_platform_idem.json>

# ---------- 3. 链上 RPC ----------

# 钱包扫描/余额读取用的 Polygon RPC(第一个优先, config.py 内置公共节点作为后续备选)。
# 生产建议专用额度节点, 避免公共节点限流导致扫描漏轮次。
GBT_EVM_RPC=https://polygon-bor-rpc.publicnode.com

# 框架侧自建只读 RPC(可选; 供 gbt_allinone 的链上辅助功能使用)。
ALCHEMY_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/<CHANGE_ME_alchemy_key>

# ---------- 4. 框架侧账本(可选覆盖) ----------

# 内部账本目录(append-only 事件 + 用户余额快照); 默认 gbt_allinone/store
GBT_LEDGER_DIR=<CHANGE_ME_or_remove_to_use_default>

# ---------- 5. 运维开关(由 deploy/ 内脚本读取) ----------

# 备份目录(backup.ps1 输出; 必须与数据根不同盘/不同机, 否则等于没备份)。
GBT_BACKUP_DIR=<CHANGE_ME_backup_dir_outside_data_root>

# 备份保留份数(超出按时间删除最旧)。
GBT_BACKUP_KEEP=14

# 反向代理对外域名(Caddyfile 示例中替换用, 仅文档用途)。
GBT_PUBLIC_HOST=wallet.example.com
